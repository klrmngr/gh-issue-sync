# --- Discord -----------------------------------------------------------------
# Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN="..."
# Right-click your server (Developer Mode on) -> Copy Server ID
GUILD_ID="..."
# Forum channels, as channelID:label pairs. Each must be a Forum channel, and
# each label must already exist in the repo. The label decides routing in both
# directions: an issue labelled `bug` opens a post in the bug forum, and a post
# opened in the bug forum files an issue labelled `bug`.
FORUM_CHANNELS="<report-a-bug-id>:bug,<feature-request-id>:enhancement"
# Where issues matching none of the labels above go (e.g. `triage`-only ones).
# Must be one of the channels listed in FORUM_CHANNELS. Leave unset to skip them.
DEFAULT_FORUM_CHANNEL_ID="<report-a-bug-id>"

# --- GitHub ------------------------------------------------------------------
# Fine-grained PAT, repository access limited to the repo below,
# permissions: Issues = Read and write, Metadata = Read-only.
GITHUB_TOKEN="github_pat_..."
GITHUB_REPO="klrmngr/mtg-edh-4player"

# --- Database ----------------------------------------------------------------
# Used by docker compose for both services. Any strong password.
DB_PASSWORD="..."
# Optional overrides: DB_HOST, DB_PORT, DB_USER, DB_NAME, DB_SSLMODE,
# or set DATABASE_URL to bypass all of them.

# --- Behaviour (all optional; defaults shown) --------------------------------
# How often to check GitHub for issue changes. Minimum 10s.
POLL_INTERVAL="60s"
# Extra label applied to every issue filed from Discord, on top of the routed
# one, to mark where it came from. Must already exist in the repo.
# Leave empty to apply none.
ISSUE_LABEL=""
# First run only: "open" mirrors currently-open issues, "none" starts from now.
BACKFILL="open"
# Archiving a post closes its issue (Discord's own inactivity timer is ignored).
CLOSE_ON_ARCHIVE="true"
# Un-archiving a post reopens its issue. Note that any new message in an
# archived post un-archives it, which will therefore reopen the issue.
REOPEN_ON_UNARCHIVE="true"
# Also lock the post when its issue closes, so only moderators can revive it.
LOCK_ON_CLOSE="false"
# Rename the post when the issue title changes.
SYNC_TITLES="true"
# Log every action instead of performing it.
DRY_RUN="false"
